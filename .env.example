APP_NAME=Eruvaaka
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eruvahli_androidApp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Amounts are INR; longer-plan defaults are the annual amount multiplied by the term.
RAZORPAY_YEARLY_AMOUNT=2
RAZORPAY_1YEAR_AMOUNT=1
RAZORPAY_3YEAR_AMOUNT=3
RAZORPAY_5YEAR_AMOUNT=5

INFINITO_SMS_ENABLED=false
INFINITO_API_URL=https://api.goinfinito.com/unified/v2/send
INFINITO_API_TOKEN=
INFINITO_SMS_FROM=your_approved_sender_id
INFINITO_SMS_OTP_DLT_TEMPLATE_ID=your_approved_otp_template_id
INFINITO_SMS_OTP_TEMPLATE=Your Eruvaaka OTP is {otp}.
INFINITO_SMS_PAYMENT_DLT_TEMPLATE_ID=your_approved_payment_template_id
INFINITO_SMS_PAYMENT_TEMPLATE=Payment confirmed for {plan}. Payment ID: {payment_id}.
INFINITO_SMS_DLT_CONTENT_TYPE=1
INFINITO_SMS_PROPERTY=0
INFINITO_SMS_COUNTRY_PREFIX=91
INFINITO_SMS_TIMEOUT=10
INFINITO_CA_BUNDLE=
INFINITO_SMS_TEST_MODE=false
INFINITO_SMS_TEST_PHONES=

ERUVAAKA_WP_API_POSTS_URL=https://eruvaaka.com/wp-json/wp/v2/posts
ERUVAAKA_WP_API_MEDIA_URL=https://eruvaaka.com/wp-json/wp/v2/media
